{
  "name": "@akua-dev/codex-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./core": "./packages/core/src/index.ts",
    "./codex": "./packages/codex/src/index.ts",
    "./bun": "./packages/bun/src/index.ts",
    "./cloudflare": "./packages/cloudflare/src/index.ts",
    "./relay": "./packages/relay/src/index.ts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint packages apps scripts vitest.config.ts --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:bun": "bun run apps/server/src/main.ts",
    "start:relay": "bun run apps/relay/src/main.ts",
    "admin:bun": "bun run apps/server/src/admin.ts",
    "canary:synthetic": "bun run scripts/synthetic-canary.ts",
    "canary:inspect": "bun run scripts/inspect-ai-gateway.ts",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc",
    "build:worker": "wrangler deploy --dry-run --config apps/worker/wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config apps/worker/wrangler.jsonc",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build:worker"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.102",
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/sql-sqlite-bun": "4.0.0-beta.102",
    "@effect/sql-sqlite-do": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/bun": "1.3.14",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "5.0.0",
    "wrangler": "4.116.0"
  }
}
