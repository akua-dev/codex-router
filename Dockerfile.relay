FROM oven/bun:canary-slim@sha256:e42c00e43df64dd27bb8f42cda0101c826c497a2f7aeaa46ffa34335843b5087

WORKDIR /app

COPY . .
RUN bun install --frozen-lockfile --production --filter @akua-dev/codex-router-relay-app

ENV HOST=0.0.0.0
ENV PORT=8788

USER bun
EXPOSE 8788

CMD ["bun", "run", "apps/relay/src/main.ts"]
